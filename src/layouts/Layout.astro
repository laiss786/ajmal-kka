---
import "@fontsource-variable/outfit";
import "@fontsource-variable/inter";
import "../styles/global.css";
import DraftBadge from "../components/DraftBadge.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} — ${site.title}`,
  description = site.tagline,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "http://localhost:4321");
// JPEG rather than PNG: the card is photographic, and the PNG was 334KB
// against 51KB here. Some scrapers cap image size before they'll unfurl.
const ogImage = new URL("/og.jpg", Astro.site ?? "http://localhost:4321");

// Person schema. Only emits fields we actually have — sameAs and email stay
// out until the client supplies them rather than shipping empty values.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.title,
  description: site.tagline,
  address: site.contact.locations.map((l) => ({
    "@type": "PostalAddress",
    addressLocality: l,
  })),
  worksFor: site.companies.map((c) => ({
    "@type": "Organization",
    name: c.name,
  })),
  ...(site.contact.email ? { email: site.contact.email } : {}),
  ...(site.contact.linkedin || site.contact.instagram
    ? { sameAs: [site.contact.linkedin, site.contact.instagram].filter(Boolean) }
    : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#0F0F12" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.title}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personSchema)}
    />

    <!-- Set before paint so reveal targets start hidden without a flash.
         If JS is off the class never lands and everything stays visible.
         The failsafe covers the other direction: if the reveal bundle fails to
         execute, un-hide everything rather than leaving a blank page. -->
    <script is:inline>
      document.documentElement.classList.add("js");
      window.__revealFailsafe = setTimeout(function () {
        document.documentElement.classList.remove("js");
      }, 2500);
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <DraftBadge />

    <script>
      // Reveal + parallax without an animation library. This replaced GSAP +
      // ScrollTrigger, which was 111KB for what amounts to fade-ups and one
      // parallax; the transitions themselves live in global.css and this only
      // decides when to trigger them.
      clearTimeout((window as any).__revealFailsafe);

      const $$ = <T extends Element>(sel: string) =>
        Array.from(document.querySelectorAll<T>(sel));

      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      // No observer means nothing would ever un-hide these, and the failsafe
      // above has already been cleared — so drop straight to visible.
      const noObserver = typeof IntersectionObserver === "undefined";

      const singles = $$<HTMLElement>("[data-reveal]");
      const groups = $$<HTMLElement>("[data-reveal-group]");
      const heroItems = $$<HTMLElement>("[data-hero-item]");
      const STAGGER = 80; // ms between siblings

      const show = (el: HTMLElement, delay = 0) => {
        if (delay) el.style.transitionDelay = `${delay}ms`;
        el.classList.add("is-in");
      };

      if (reduceMotion || noObserver) {
        [...singles, ...heroItems, ...groups.flatMap((g) => [...g.children])].forEach(
          (el) => (el as HTMLElement).classList.add("is-in"),
        );
      } else {
        // Hero is already in view on load, so it plays immediately rather than
        // waiting on an observer that would fire at once and lose the stagger.
        requestAnimationFrame(() =>
          heroItems.forEach((el, i) => show(el, 150 + i * 100)),
        );

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              if (el.hasAttribute("data-reveal-group")) {
                Array.from(el.children).forEach((child, i) =>
                  show(child as HTMLElement, i * STAGGER),
                );
              } else {
                show(el);
              }
              io.unobserve(el);
            }
          },
          // ~15% up from the bottom edge, matching the old "top 85%".
          { rootMargin: "0px 0px -15% 0px", threshold: 0 },
        );

        [...singles, ...groups].forEach((el) => io.observe(el));

        // Parallax, rAF-throttled so it never runs more than once a frame.
        const parallax = $$<HTMLElement>("[data-parallax]");
        if (parallax.length) {
          let queued = false;
          const update = () => {
            queued = false;
            const vh = innerHeight;
            for (const el of parallax) {
              const r = el.getBoundingClientRect();
              if (r.bottom < 0 || r.top > vh) continue; // offscreen: skip
              const strength = Number(el.dataset.parallax) || 8;
              const progress = (r.top + r.height / 2 - vh / 2) / vh;
              el.style.transform = `translate3d(0, ${(progress * strength).toFixed(2)}%, 0)`;
            }
          };
          const onScroll = () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(update);
          };
          update();
          addEventListener("scroll", onScroll, { passive: true });
          addEventListener("resize", onScroll, { passive: true });
        }
      }

      // Nav solidifies once the hero is behind it.
      const header = document.querySelector("header");
      if (header) {
        const syncHeader = () =>
          header.classList.toggle("is-scrolled", scrollY > 80);
        syncHeader();
        addEventListener("scroll", syncHeader, { passive: true });
      }
    </script>
  </body>
</html>
