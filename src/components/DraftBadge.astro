---
import { site } from "../data/site";
---

{
  site.draft && (
    <div
      class="pointer-events-none fixed bottom-4 left-4 z-100 rounded-full border border-dashed border-gold/40 bg-obsidian/90 px-4 py-2 text-xs text-gold/80 backdrop-blur-sm"
      role="status"
    >
      Draft — placeholder content. Set <code class="font-mono">site.draft</code> to
      false before launch.
    </div>
  )
}
