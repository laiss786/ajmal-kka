---
import { site } from "../data/site";
import Pending from "./Pending.astro";

const year = new Date().getFullYear();
---

<footer data-nav-theme="dark" class="relative overflow-hidden bg-obsidian text-white">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-gold/40 to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-1/3 left-1/2 size-[60vw] -translate-x-1/2 rounded-full bg-radial from-gold/6 to-transparent blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="wrap relative py-20 md:py-24">
    <!-- CTA band -->
    <div
      data-reveal
      class="flex flex-col items-start justify-between gap-8 border-b border-white/10 pb-16 md:flex-row md:items-end"
    >
      <div>
        <p class="eyebrow eyebrow-on-dark">Get in touch</p>
        <h2 class="mt-3 max-w-xl text-white">
          Let's talk about where your brand goes next.
        </h2>
      </div>
      <a href="#contact" class="btn btn-gold focus-ring shrink-0">Start a conversation</a>
    </div>

    <!-- Link columns -->
    <div class="grid gap-12 pt-16 sm:grid-cols-2 md:grid-cols-4">
      <div data-reveal>
        <p class="font-display text-lg font-light text-white">{site.name}</p>
        <p class="mt-3 max-w-40 text-sm text-white/60">{site.title}</p>
      </div>

      <nav data-reveal aria-label="Footer">
        <p class="text-xs tracking-widest text-white/60 uppercase">Site</p>
        <ul class="mt-4 space-y-3">
          {
            site.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="focus-ring rounded-sm text-sm text-white/70 transition-colors hover:text-gold"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div data-reveal>
        <p class="text-xs tracking-widest text-white/60 uppercase">Contact</p>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            {
              site.contact.email ? (
                <a
                  href={`mailto:${site.contact.email}`}
                  class="focus-ring rounded-sm text-white/70 transition-colors hover:text-gold"
                >
                  {site.contact.email}
                </a>
              ) : (
                <Pending dark label="Email pending" />
              )
            }
          </li>
          <li>
            {
              site.contact.linkedin ? (
                <a
                  href={site.contact.linkedin}
                  class="focus-ring rounded-sm text-white/70 transition-colors hover:text-gold"
                >
                  LinkedIn
                </a>
              ) : (
                <span class="text-white/60">LinkedIn — pending</span>
              )
            }
          </li>
          <li>
            {
              site.contact.instagram ? (
                <a
                  href={site.contact.instagram}
                  class="focus-ring rounded-sm text-white/70 transition-colors hover:text-gold"
                >
                  Instagram
                </a>
              ) : (
                <span class="text-white/60">Instagram — pending</span>
              )
            }
          </li>
        </ul>
      </div>

      <div data-reveal>
        <p class="text-xs tracking-widest text-white/60 uppercase">Based in</p>
        <ul class="mt-4 space-y-3 text-sm text-white/70">
          {site.contact.locations.map((loc) => <li>{loc}</li>)}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-16 flex flex-col-reverse items-center justify-between gap-6 border-t border-white/10 pt-8 text-sm text-white/60 sm:flex-row"
    >
      <p>© {year} {site.name}. All rights reserved.</p>

      <div class="flex items-center gap-6">
        <p>
          Built by <span class="text-gold">Kaelo Solutions</span>
        </p>
        <a
          href="#top"
          class="focus-ring flex items-center gap-1.5 rounded-sm text-white/60 transition-colors hover:text-gold"
          aria-label="Back to top"
        >
          Back to top
          <svg
            class="size-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M12 19V5M5 12l7-7 7 7" stroke-linecap="round" stroke-linejoin="round"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
