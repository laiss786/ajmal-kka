---
import { site } from "../data/site";
import Pending from "./Pending.astro";

// Portrait slot is intentionally empty until the client supplies the headshot.
// To drop it in: put the file in src/assets/, import it here, and replace the
// placeholder block below with:
//
//   <Image src={portrait} alt={`${site.name}, ${site.title}`}
//          widths={[600, 900, 1200]} sizes="(min-width: 768px) 40vw, 90vw"
//          class="aspect-4/5 w-full rounded-xl object-cover" loading="eager" />
//
// (add `import { Image } from "astro:assets";` back at the top)
---

{/* min-h-svh, not min-h-screen: on mobile the browser chrome makes 100vh
    taller than the visible area, which pushed the hero past one scroll. */}
<section
  id="top"
  data-nav-theme="dark"
  class="relative flex min-h-svh items-center overflow-hidden bg-obsidian pt-16 text-white"
>
  {/* Soft gold bloom behind the copy so the dark ground isn't flat. */}
  <div
    class="pointer-events-none absolute -top-1/4 -left-1/4 size-[70vw] rounded-full bg-radial from-gold/8 to-transparent blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="wrap relative grid w-full items-center gap-12 py-16 md:grid-cols-12 lg:gap-20">
    <div class="md:col-span-7">
      <p data-hero-item class="eyebrow eyebrow-on-dark">{site.title}</p>

      <h1 data-hero-item class="mt-5 text-white">{site.name}</h1>

      <p data-hero-item class="prose-measure mt-6 text-lg text-white/70">
        {site.tagline}
      </p>

      <div data-hero-item class="mt-8 flex flex-wrap gap-4">
        <a href="#companies" class="btn btn-gold focus-ring">View experience</a>
        <a href="#contact" class="btn btn-outline focus-ring">Get in touch</a>
      </div>

      {/* Figures live here rather than in a separate band — they fill the hero
          and give the fold something concrete to say. */}
      <dl
        data-hero-item
        class="mt-12 grid max-w-lg grid-cols-3 gap-6 border-t border-white/10 pt-8"
      >
        {
          site.stats.map((stat) => (
            <div>
              <dt class="sr-only">{stat.label}</dt>
              <dd>
                <span class="font-display block text-4xl font-extralight text-gold">
                  {stat.value}
                  {stat.suffix}
                </span>
                <span class="mt-2 block text-xs leading-snug text-white/60">
                  {stat.label}
                </span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div data-hero-item class="md:col-span-5">
      <div data-parallax="4" class="will-change-transform">
        <div
          class="relative flex aspect-4/5 w-full flex-col items-center justify-center gap-4 overflow-hidden rounded-2xl border border-dashed border-white/20 bg-panel-dark"
        >
          <div
            class="pointer-events-none absolute inset-0 bg-radial from-gold/12 to-transparent"
            aria-hidden="true"
          >
          </div>

          <svg
            class="relative size-10 text-white/25"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            aria-hidden="true"
          >
            <circle cx="12" cy="8.5" r="3.75"></circle>
            <path d="M4.5 20a7.5 7.5 0 0 1 15 0" stroke-linecap="round"></path>
          </svg>

          <p class="relative text-sm text-white/50">Portrait</p>

          {site.draft && <Pending dark class="relative" label="Headshot pending" />}
        </div>
      </div>
    </div>
  </div>

  <div
    class="absolute inset-x-0 bottom-0 h-px bg-linear-to-r from-transparent via-gold/40 to-transparent"
  >
  </div>
</section>
