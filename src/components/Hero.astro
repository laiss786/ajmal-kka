---
import { site } from "../data/site";
import Pending from "./Pending.astro";

// Portrait slot is intentionally empty until the client supplies the headshot.
// To drop it in: put the file in src/assets/, import it here, and replace the
// placeholder block below with:
//
//   <Image src={portrait} alt={`${site.name}, ${site.title}`}
//          widths={[600, 900, 1200]} sizes="(min-width: 768px) 40vw, 90vw"
//          class="aspect-4/5 w-full rounded-xl object-cover" loading="eager" />
//
// (add `import { Image } from "astro:assets";` back at the top)
---

<section
  id="top"
  class="relative flex min-h-screen items-center overflow-hidden bg-obsidian pt-16 text-white"
>
  <div class="wrap grid items-center gap-16 py-24 md:grid-cols-12">
    <div class="md:col-span-7">
      <p data-hero-item class="eyebrow eyebrow-on-dark">{site.title}</p>

      <h1 data-hero-item class="mt-6 text-white">{site.name}</h1>

      <p data-hero-item class="prose-measure mt-8 text-lg text-white/70">
        {site.tagline}
      </p>

      <div data-hero-item class="mt-10 flex flex-wrap gap-4">
        <a href="#projects" class="btn btn-gold focus-ring">View my work</a>
        <a href="#contact" class="btn btn-outline focus-ring">Get in touch</a>
      </div>

    </div>

    <div data-hero-item class="md:col-span-5">
      <div data-parallax="5" class="will-change-transform">
        <div
          class="relative flex aspect-4/5 w-full flex-col items-center justify-center gap-4 overflow-hidden rounded-xl border border-dashed border-white/20 bg-panel-dark"
        >
          {/* Faint gold wash so the empty slot still reads as designed. */}
          <div
            class="pointer-events-none absolute inset-0 bg-radial from-gold/12 to-transparent"
            aria-hidden="true"
          >
          </div>

          <svg
            class="relative size-10 text-white/25"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            aria-hidden="true"
          >
            <circle cx="12" cy="8.5" r="3.75"></circle>
            <path d="M4.5 20a7.5 7.5 0 0 1 15 0" stroke-linecap="round"></path>
          </svg>

          <p class="relative text-sm text-white/50">Portrait</p>

          {site.draft && <Pending dark class="relative" label="Headshot pending" />}
        </div>
      </div>
    </div>
  </div>

  <div
    class="absolute inset-x-0 bottom-0 h-px bg-linear-to-r from-transparent via-gold/40 to-transparent"
  >
  </div>
</section>
