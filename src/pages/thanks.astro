---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---

<Layout
  title={`Thanks — ${site.name}`}
  description="Your message has been sent."
>
  <main id="main" class="flex min-h-screen items-center bg-obsidian text-white">
    <div class="wrap">
      <p class="eyebrow eyebrow-on-dark">Message sent</p>

      <h1 class="mt-6 text-white">Thank you</h1>

      <p class="prose-measure mt-6 text-lg text-white/60">
        Your message has come through. {site.name.split(" ")[0]} will get back to
        you shortly.
      </p>

      <div class="mt-10">
        <a href="/" class="btn btn-gold focus-ring">Back to home</a>
      </div>
    </div>
  </main>
</Layout>
